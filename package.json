{
  "name": "smartfoodpop-workspace",
  "version": "1.0.0",
  "description": "SmartFoodPop Workspace - Popayán, Cauca",
  "scripts": {
    "dev": "node run-dev.js",
    "start": "node run-dev.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "scrape": "python scraper/scraper.py",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "lint": "npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:check": "npm --prefix backend run db:check"
  },
  "keywords": [],
