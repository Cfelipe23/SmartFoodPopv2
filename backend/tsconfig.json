{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": true,
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": true
  },
  "include": ["src/**/*.js", "src/**/*.ts"]
}
