{
  "name": "smartfoodpop-backend",
  "version": "1.0.0",
  "description": "Backend API for SmartFoodPop web application",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "dev": "node scripts/dev.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "db:check": "node scripts/check-db.js",
    "db:setup": "node scripts/setup-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "pg-mem": "^3.0.14",
    "typescript": "5.9.3"
  }
}
