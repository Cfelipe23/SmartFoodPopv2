# Copia este archivo a backend/.env y ajusta los valores.
PORT=5000

# Obligatorio en producción (NODE_ENV=production). Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto

# PostgreSQL (requerido por el alcance del proyecto). Sin estas variables el servidor
# funciona SOLO en memoria (los datos se pierden al reiniciar).
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/smartfoodpop
# Alternativa: PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE

# Contraseñas de las cuentas de demostración (usuario@popayan.com y admin@smartfood.com).
# Si no se definen se usan valores de desarrollo.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# true = reconstruye el catálogo en la base desde scraper/output/scraped_products_api.json
# (conserva usuarios; elimina reseñas y favoritos porque cambian los ids de productos).
RESEED_CATALOG=false
